{
  "_meta": {
    "source": "https://www.hevyapp.com/",
    "method": "manual extraction using the Firecrawl branding schema",
    "captured_at": "2026-11-14",
    "usage": "reference only: workout-log UX patterns. Not used as Kachlog palette or brand."
  },
  "colorScheme": "light",
  "colors": {
    "primary": "#1D83EA",
    "background": "#FFFFFF",
    "surface": "#F2F4F7",
    "text": "#191A1B",
    "mutedText": "#4A4E57",
    "border": "#E3E1E8",
    "dark": "#010101"
  },
  "typography": {
    "fontFamilies": {
      "heading": "Catamaran SemiBold",
      "body": "Catamaran Regular"
    },
    "weights": {
      "regular": 400,
      "semibold": 600
    }
  },
  "spacing": {
    "baseUnit": 8,
    "borderRadius": "12px",
    "density": "comfortable"
  },
  "components": {
    "buttonPrimary": {
      "background": "#1D83EA",
      "text": "#FFFFFF",
